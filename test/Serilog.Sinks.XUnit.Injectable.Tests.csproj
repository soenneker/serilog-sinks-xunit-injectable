<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Tests.Benchmark" Version="11.0.221" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="11.0.348" />
        <PackageReference Include="TUnit" Version="1.78.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\sample\SampleApi.csproj" />
        <ProjectReference Include="..\src\Serilog.Sinks.XUnit.Injectable\Serilog.Sinks.XUnit.Injectable.csproj" />
    </ItemGroup>
</Project>



